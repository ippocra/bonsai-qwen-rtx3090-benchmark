def two_sum(nums: list[int], target: int) -> tuple[int, int]:
    """
    Find two numbers in the list that add up to the target.

    Args:
        nums: A list of integers.
        target: The target sum to find.

    Returns:
        A tuple containing the two numbers that add up to the target.

    Raises:
        ValueError: If no pair of numbers in the list adds up to the target.
    """
    seen = {}
    for i, num in enumerate(nums):
        complement = target - num
        if complement in seen:
            return (complement, num)
        seen[num] = i
    raise ValueError("No two numbers in the list add up to the target.")
